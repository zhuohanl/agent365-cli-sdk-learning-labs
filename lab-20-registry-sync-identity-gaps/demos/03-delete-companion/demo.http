# Current first-party documentation says deleting the Blueprint application
# also deletes its principal and asynchronously cleans up child identities.
# This experiment verifies the behavior for this disposable dedicated group.

# @name deleteDedicatedBlueprint
DELETE {{graphBaseUrl}}/v1.0/applications/{{blueprintObjectId}}/microsoft.graph.agentIdentityBlueprint
Authorization: Bearer {{deleteBlueprintToken.response.body.$.access_token}}
Accept: application/json

###

