###############################################################################
# Stop C - separately approve dedicated Blueprint group cleanup
#
# Continue only when:
# - assignmentMode is dedicated;
# - lifecycleStatus is retired;
# - no active or pending mapping remains in blueprintGroup;
# - the mapped Agent Identity is already retired;
# - the Blueprint and principal IDs match the locked mapping;
# - the operator understands that Blueprint deletion is soft deletion and
#   triggers asynchronous cascade cleanup of associated child identities; and
# - dedicated Blueprint deletion is explicitly approved.
#
# Do not continue for shared mode. Keep blueprintCleanup.status=active with
# reason shared-group-not-empty.
#
# After approval, run:
#
# python demos/03-delete-companion/prototype_retirement_mapping.py `
#   --mapping evidence/demos/03-delete-companion/mapping.json `
#   --output evidence/demos/03-delete-companion/mapping.json `
#   event blueprint-cleanup-started
#
# Confirm blueprintCleanup.status=pending and both Blueprint objects are
# pending before requesting the separately scoped deletion token.

###############################################################################
# Authentication 3 - Request a Blueprint cleanup device code
#
# Do not reuse a token that lacks AgentIdentityBlueprint.DeleteRestore.All.
# Never save this response. Stop rather than approve unexpected permissions.

# @name deleteBlueprintStartDeviceCode
POST https://login.microsoftonline.com/{{tenantId}}/oauth2/v2.0/devicecode
Content-Type: application/x-www-form-urlencoded

client_id={{clientId}}&scope={{blueprintDeleteScopes}}

###

###############################################################################
# Authentication 4 - Exchange the Blueprint cleanup device code
#
# Never save this response.

# @name deleteBlueprintToken
POST https://login.microsoftonline.com/{{tenantId}}/oauth2/v2.0/token
Content-Type: application/x-www-form-urlencoded

grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code&client_id={{clientId}}&device_code={{deleteBlueprintStartDeviceCode.response.body.$.device_code}}

###

